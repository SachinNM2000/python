   "source": [
    "#print number of vowels in given string\n",
    "\n",
    "vowels=['a','e','i','o','u']\n",
    "str = input(\"Enter String:\")\n",
    "\n",
    "count=0\n",
    "for char in str:\n",
    "    if char in vowels:\n",
    "        count=count+1\n",
    "print(count)"
   ]
